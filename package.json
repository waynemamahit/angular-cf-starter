{
  "name": "angular-cf-starter",
  "version": "0.0.0",
  "engines": {
    "node": "24.17.0"
  },
  "scripts": {
    "postinstall": "pnpm typecheck",
    "ng": "ng",
    "dev": "ng serve",
    "lint": "ng lint",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:ssr": "node dist/angular-cf-starter/server/server.mjs",
    "preview": "ng run angular-cf-starter:preview && node scripts/gen-wrangler.js local && wrangler dev --local",
    "preview:remote": "ng run angular-cf-starter:preview && node scripts/gen-wrangler.js local && wrangler dev",
    "test": "ng test",
    "test:run": "ng test --watch=false",
    "test:cov": "pnpm test --coverage",
    "test:out": "pnpm test --reporters='json' --output-file='./test-results.json'",
    "test:browser": "pnpm test --browsers=chromiumHeadless",
    "test:e2e": "playwright test",
    "typecheck": "wrangler types"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.0.2",
    "@angular/compiler": "22.0.2",
    "@angular/core": "22.0.2",
    "@angular/forms": "22.0.2",
    "@angular/platform-browser": "22.0.2",
    "@angular/platform-server": "22.0.2",
    "@angular/router": "22.0.2",
    "@angular/ssr": "22.0.3",
    "@hono/zod-validator": "0.8.0",
    "@lucide/angular": "^1.21.0",
    "angular-i18next": "21.0.0",
    "awilix": "13.0.5",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.26",
    "hono-rate-limiter": "^0.5.3",
    "i18next": "26.3.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.0.0",
    "@angular/build": "22.0.3",
    "@angular/cli": "22.0.3",
    "@angular/compiler-cli": "22.0.2",
    "@angular/localize": "22.0.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "26.0.0",
    "@vitest/browser-playwright": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "angular-eslint": "22.0.0",
    "daisyui": "5.5.23",
    "drizzle-kit": "0.31.10",
    "eslint": "10.5.0",
    "jsdom": "29.1.1",
    "playwright": "1.61.0",
    "postcss": "8.5.15",
    "prettier": "3.8.4",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "vitest": "4.1.9",
    "wrangler": "4.103.0",
    "xhr2": "0.2.1"
  }
}
