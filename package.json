{
	"name": "angular-cf-starter",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"serve:ssr": "node dist/angular-cf-starter/server/server.mjs",
		"preview": "pnpm run build && wrangler dev",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"prettier": {
		"printWidth": 100,
		"singleQuote": true,
		"overrides": [
			{
				"files": "*.html",
				"options": {
					"parser": "angular"
				}
			}
		]
	},
	"private": true,
	"packageManager": "pnpm@10.26.2",
	"dependencies": {
		"@angular/common": "^21.0.6",
		"@angular/compiler": "^21.0.6",
		"@angular/core": "^21.0.6",
		"@angular/forms": "^21.0.6",
		"@angular/platform-browser": "^21.0.6",
		"@angular/platform-server": "^21.0.6",
		"@angular/router": "^21.0.6",
		"@angular/ssr": "^21.0.4",
		"hono": "^4.11.1",
		"rxjs": "~7.8.2",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@angular/build": "^21.0.4",
		"@angular/cli": "^21.0.4",
		"@angular/compiler-cli": "^21.0.6",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/node": "^25.0.3",
		"jsdom": "^27.3.0",
		"postcss": "^8.5.6",
		"prettier": "^3.7.4",
		"tailwindcss": "^4.1.18",
		"typescript": "~5.9.3",
		"vitest": "^4.0.16",
		"wrangler": "^4.56.0",
		"xhr2": "^0.2.1"
	}
}
